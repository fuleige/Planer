{
  "name": "xushi-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev --host 0.0.0.0 --port 3000",
    "build": "vinext build",
    "start": "node scripts/start-local.mjs",
    "start:lan": "node scripts/start-local.mjs --lan",
    "auth:setup": "node scripts/manage-auth.mjs setup",
    "auth:show": "node scripts/manage-auth.mjs show",
    "auth:rotate": "node scripts/manage-auth.mjs rotate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --file=drizzle/0000_init.sql --config wrangler.local.jsonc",
    "db:upgrade:local": "wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --file=drizzle/0001_weekly-cycle-and-area-dates.sql --config wrangler.local.jsonc",
    "db:seed:local": "wrangler d1 execute site-creator-d1 --local --persist-to .wrangler/state --file=db/seed-demo.sql --config wrangler.local.jsonc",
    "db:setup:local": "npm run db:migrate:local && npm run db:upgrade:local && npm run db:seed:local",
    "lint": "oxlint app components/auth components/planner db lib proxy.ts scripts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
